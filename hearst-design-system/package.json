{
  "name": "hearst-design-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --import tsx --test src/lib/*.test.ts src/components/ui/*.test.ts",
    "test:a11y:carousel": "node scripts/test-featured-carousel-a11y.mjs",
    "test:storybook:docs": "node scripts/test-storybook-docs.mjs",
    "test:storybook:responsive": "node scripts/test-storybook-responsive.mjs",
    "verify:storybook:deployment": "node scripts/verify-storybook-deployment.mjs",
    "test:visual": "npm run build-storybook && node scripts/test-storybook-visuals.mjs",
    "test:visual:update": "npm run build-storybook && node scripts/test-storybook-visuals.mjs --update",
    "quality": "npm run index:check && npm run tokens:check && npm run tokens:validate && npm run tokens:audit:ci && npm run publications:validate && npm run test:unit && npm run test-storybook && npm run test:a11y:carousel && npm run test:visual && npm run test:storybook:responsive && npm run test:storybook:docs",
    "feed:refresh": "node scripts/import-lifestyle-rss.mjs && node scripts/import-autos-rss.mjs && node scripts/import-flux-rss.mjs && node scripts/import-ew-rss.mjs && node scripts/enrich-river-bylines.mjs && npm run feed:validate && npm run storybook:fixtures",
    "feed:bylines": "node scripts/enrich-river-bylines.mjs",
    "feed:validate": "node --import tsx scripts/validate-story-feed.ts",
    "feed:check:local-news": "node --import tsx scripts/check-local-news-feeds.ts",
    "build-tokens": "tsx scripts/build-from-tokens.ts",
    "push-pencil": "tsx scripts/push-to-pencil.ts",
    "push-figma": "tsx scripts/push-to-figma.ts",
    "sync-tokens": "tsx scripts/sync-tokens.ts",
    "sync-pencil": "tsx scripts/sync-from-pencil.ts",
    "sync-to-pencil": "tsx scripts/sync-to-pencil.ts",
    "sync-watch": "tsx scripts/watch-sync.ts",
    "tokens:import": "tsx scripts/import-token-studio.ts",
    "tokens:import:snapshot": "tsx scripts/import-token-studio.ts --snapshot-only",
    "tokens:validate": "tsx scripts/validate-tokens.ts",
    "tokens:check": "tsx scripts/check-tokens.ts",
    "publications:validate": "tsx scripts/validate-publications.ts",
    "editorial:crops": "tsx scripts/suggest-editorial-crops.ts",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "tokens:pipeline": "npm run tokens:import && npm run tokens:build",
    "prestorybook": "npm run index",
    "storybook": "storybook dev -p 6006",
    "storybook:fixtures": "tsx scripts/generate-storybook-fixtures.ts",
    "prebuild-storybook": "npm run index",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook --run",
    "audit": "tsx scripts/audit-tokens.ts",
    "audit:json": "tsx scripts/audit-tokens.ts --json",
    "tokens:audit:ci": "tsx scripts/audit-tokens.ts --ci",
    "tokens:audit:baseline": "tsx scripts/audit-tokens.ts --write-baseline",
    "index": "tsx scripts/index-components.ts",
    "index:check": "tsx scripts/index-components.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@dagrejs/dagre": "^3.0.0",
    "@netlify/blobs": "^10.7.10",
    "@netlify/plugin-nextjs": "^5.15.8",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.6.16",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-themes": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/experimental-addon-test": "8.6.18",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "smartcrop": "^2.0.5",
    "storybook": "^8.6.18",
    "style-dictionary": "^5.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
